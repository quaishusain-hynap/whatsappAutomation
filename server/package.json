{
  "name": "@mb/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p ../shared/tsconfig.json && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@mb/shared": "*",
    "@prisma/client": "^6.2.1",
    "@whiskeysockets/baileys": "6.7.24",
    "argon2": "^0.41.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
