# ==============================================================================
# Nginx Configuration for wawhatsapp.tripaxiscrm.com
# File location: /etc/nginx/sites-available/wawhatsapp.tripaxiscrm.com
# Enable with:   sudo ln -s /etc/nginx/sites-available/wawhatsapp.tripaxiscrm.com /etc/nginx/sites-enabled/
# ==============================================================================

upstream backend_nodes {
    server 127.0.0.1:4000;
    keepalive 64;
}

server {
    listen 80;
    server_name wawhatsapp.tripaxiscrm.com;

    # Allow large uploads for WhatsApp media/documents (audio, video, large PDFs)
    client_max_body_size 64M;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # 1. Frontend: React static files built by Vite
    root /var/www/whatsappAutomation/web/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache immutable static assets (JS/CSS/images)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, no-transform, immutable";
    }

    # 2. Backend REST API
    location /api/ {
        proxy_pass http://backend_nodes;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Upload and download timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # 3. Realtime Socket.IO / WebSocket Proxy
    location /socket.io/ {
        proxy_pass http://backend_nodes;
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep WebSockets open indefinitely during chat sessions
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
